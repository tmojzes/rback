#!/bin/bash
set -euo pipefail

if ! command -v rback &>/dev/null; then
  echo "Error: 'rback' is not installed or not in PATH." >&2
  echo "Please install rback first (e.g. 'go install github.com/tmojzes/rback@latest')." >&2
  exit 1
fi

if ! command -v dot &>/dev/null; then
  echo "Error: Graphviz 'dot' is not installed or not in PATH." >&2
  echo "Please install Graphviz (e.g. 'brew install graphviz' on macOS or 'sudo apt-get install graphviz' on Linux)." >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin*)
    OPEN_CMD="open"
    ;;
  Linux*)
    OPEN_CMD="xdg-open"
    ;;
  CYGWIN*|MINGW*|MSYS*)
    OPEN_CMD="start"
    ;;
  *)
    OPEN_CMD="xdg-open"
    ;;
esac

FORMAT="${RBACK_FORMAT:-svg}"
RBACK_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --png)
      FORMAT="png"
      ;;
    --svg)
      FORMAT="svg"
      ;;
    --format=*)
      FORMAT="${arg#*=}"
      ;;
    *)
      RBACK_ARGS+=("$arg")
      ;;
  esac
done

TMP_BASE="$(mktemp -t rback 2>/dev/null || mktemp "${TMPDIR:-/tmp}/rback-XXXXXX")"
TMP_DOT="${TMP_BASE}.dot"
TMP_OUT="${TMP_BASE}.${FORMAT}"
trap 'rm -f "$TMP_BASE" "$TMP_DOT"' EXIT

kubectl get sa,roles,rolebindings,clusterroles,clusterrolebindings --all-namespaces -o json | \
  rback ${RBACK_ARGS[@]+"${RBACK_ARGS[@]}"} > "$TMP_DOT" && \
  dot "$TMP_DOT" "-T${FORMAT}" -Gsplines=spline -Kdot > "$TMP_OUT" && \
  $OPEN_CMD "$TMP_OUT"
